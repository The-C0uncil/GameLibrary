@using Microsoft.Extensions.Configuration
@inject IConfiguration CouncilConfiguration
@{
    var action = ViewContext.RouteData.Values["action"]?.ToString();
    var controller = ViewContext.RouteData.Values["controller"]?.ToString();
    var publicPage = controller == "Home" && (action == "Index" || action == "HowItWorks" || action == "About");
    var how = Url.Action("HowItWorks", "Home");
    var about = Url.Action("About", "Home");
    var login = CouncilConfiguration["Council:LoginUrl"];
    var whatsapp = CouncilConfiguration["Council:WhatsAppNumber"] ?? "";
    var whatsappReady = whatsapp.Length >= 8 && whatsapp.Length <= 15 &&
System.Text.RegularExpressions.Regex.IsMatch(whatsapp, "^[1-9][0-9]+$");
}
<!DOCTYPE html>
<html lang="pt-PT">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@ViewData["Title"] · The Council</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" />
    @if (!publicPage)
    {
        <link rel="stylesheet"
              href="https://fonts.googleapis.com/css2?family=Roboto:wght@400;700&family=Marcellus+SC&family=Material+Symbols+Rounded" />
        <link rel="stylesheet" href="@Url.Content("~/css/site.css")" />
    }
    <link rel="stylesheet" href="@Url.Content("~/css/council.css")" />
    @await RenderSectionAsync("Styles", required: false)
</head>

<body class="council-site @(publicPage ? "council-public" : "council-legacy")">
    <a class="skip-link" href="#main-content">Saltar para o conteúdo</a>
    <header class="council-header sticky-top" data-bs-theme="dark">
        <nav class="navbar navbar-expand-lg" aria-label="Navegação principal">
            <div class="container-xxl">
                <a class="navbar-brand council-brand" href="@Url.Action("Index", "Home")">THE COUNCIL <img
                    src="@Url.Content("~/images/logo.png")" alt="" aria-hidden="true" /></a>
                    <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#council-menu"
                            aria-controls="council-menu" aria-expanded="false" aria-label="Abrir menu"><span
                        class="navbar-toggler-icon"></span></button>
                        <div class="collapse navbar-collapse" id="council-menu">
                            <ul class="navbar-nav ms-auto align-items-lg-center gap-lg-4">
                                <li class="nav-item dropdown">
                                    <button class="nav-link dropdown-toggle @(action == "HowItWorks" ? "active" : "")"
                                            data-bs-toggle="dropdown" aria-expanded="false">Como funciona</button>
                                    <ul class="dropdown-menu">
                                        <li><a class="dropdown-item" href="@(how)#modelos">Modelos de jogo</a></li>
                                        <li><a class="dropdown-item" href="@(how)#precos">Preços</a></li>
                                        <li><a class="dropdown-item" href="@(how)#reservas">Reservas</a></li>
                                        <li><a class="dropdown-item" href="@(how)#regras">Regras</a></li>
                                    </ul>
                                </li>
                                <li class="nav-item dropdown">
                                    <button class="nav-link dropdown-toggle @(action == "About" ? "active" : "")"
                                            data-bs-toggle="dropdown" aria-expanded="false">Sobre</button>
                                    <ul class="dropdown-menu">
                                        <li><a class="dropdown-item" href="@(about)#projeto">Projeto</a></li>
                                        <li><a class="dropdown-item" href="@(about)#game-masters">Game Masters</a></li>
                                    </ul>
                                </li>
                                @* <li class="nav-item my-2 my-lg-0">
                                    @if (!string.IsNullOrWhiteSpace(login))
                                    {
                                        <a class="btn btn-council" href="@Url.Content(login)">Entrar / Criar conta</a>
                                    }
                                    else
                                    {

                                        <button class="btn btn-council" type="button" data-bs-toggle="modal"
                                                data-bs-target="#account-info">Entrar / Criar conta</button>
                                    }
                                </li> *@
                            </ul>
                        </div>
                    </div>
                </nav>
                @if (action == "HowItWorks" && controller == "Home")
                {
                    <nav class="council-subnav" aria-label="Secções de Como funciona"><a href="#modelos">Modelos de jogo</a><a
                        href="#precos">Preços</a><a href="#reservas">Reservas</a><a href="#regras">Regras</a></nav>
                    }
                    @if (action == "About" && controller == "Home")
                    {
                        <nav class="council-subnav" aria-label="Secções de Sobre"><a href="#projeto">Projeto</a><a
                            href="#game-masters">Game Masters</a></nav>
                        }
                    </header>
                    <main id="main-content" tabindex="-1">@RenderBody()</main>
                    <footer class="council-footer">
                        <div class="container-xxl">
                            <div class="row g-5">
                                <div class="col-md-5"><a class="council-brand" href="@Url.Action("Index", "Home")">THE COUNCIL <img
                                    src="@Url.Content("~/images/logo.png")" alt="" aria-hidden="true" /></a>
                                    <p class="mt-3">Como é que queres jogar?</p>
                                </div>
                                <div class="col-6 col-md-3">
                                    <h2>Explorar</h2><a href="@(how)#modelos">Modelos de jogo</a><a href="@(how)#precos">Preços</a><a
                                    href="@(how)#reservas">Reservas</a><a href="@(how)#regras">Regras</a>
                                </div>
                                <div class="col-6 col-md-4">
                                    <h2>The Council</h2><a href="@(about)#projeto">Projeto</a><a href="@(about)#game-masters">Game
                                    Masters</a><a href="@Url.Action("Library", "Home")">Biblioteca de jogos</a><a
                                    href="https://www.instagram.com/join.thecouncil/" target="_blank" rel="noopener noreferrer"><img
                                    class="instagram-logo" src="@Url.Content("~/images/brand-logos/instagram-logo.svg")"
                                    alt="Instagram" /></a>
                                </div>
                            </div>
                            <div class="footer-bottom"><small>© @DateTime.Now.Year The Council</small><span>Boas histórias
                                encontram sempre mesa.</span></div>
                            </div>
                        </footer>
                        @if (whatsappReady)
                        {
                            <a class="council-whatsapp" href="https://wa.me/@whatsapp" target="_blank" rel="noopener noreferrer"
                               aria-label="Contactar The Council por WhatsApp">@await Html.PartialAsync("_WhatsAppIcon")</a>
                        }
                        else
                        {
                            <button class="council-whatsapp" type="button" data-bs-toggle="modal" data-bs-target="#contact-info"
                                    aria-label="Contacto WhatsApp">@await Html.PartialAsync("_WhatsAppIcon")</button>
                        }
                        <div class="modal fade" id="contact-info" tabindex="-1" aria-labelledby="contact-title" aria-hidden="true">
                            <div class="modal-dialog modal-dialog-centered">
                                <div class="modal-content">
                                    <div class="modal-header">
                                        <h2 class="modal-title fs-4" id="contact-title">Vamos conversar</h2><button type="button"
                                                                                                                    class="btn-close" data-bs-dismiss="modal" aria-label="Fechar"></button>
                                    </div>
                                    <div class="modal-body">
                                        <p>O contacto por WhatsApp estará disponível em breve. Entretanto, fala connosco no Instagram.</p><a
                                        class="btn btn-council" href="https://www.instagram.com/join.thecouncil/" target="_blank"
                                        rel="noopener noreferrer">Abrir Instagram</a>
                                    </div>
                                </div>
                            </div>
                        </div>
                        <div class="modal fade" id="account-info" tabindex="-1" aria-labelledby="account-title" aria-hidden="true">
                            <div class="modal-dialog modal-dialog-centered">
                                <div class="modal-content">
                                    <div class="modal-header">
                                        <h2 class="modal-title fs-4" id="account-title">A tua conta</h2><button type="button"
                                                                                                                class="btn-close" data-bs-dismiss="modal" aria-label="Fechar"></button>
                                    </div>
                                    <div class="modal-body">O acesso à conta estará disponível em breve.</div>
                                </div>
                            </div>
                        </div>
                        <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
                        @if (!publicPage)
                        {
                            <script src="@Url.Content("~/js/site.js")"></script>
                        }
                        <script src="@Url.Content("~/js/council.js")"></script>
                        @await RenderSectionAsync("Scripts", required: false)
                    </body>

                </html>
