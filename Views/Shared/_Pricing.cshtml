<section id="precos" class="council-section pricing-section">
    <div class="container-xxl"><span class="section-number">02</span>
        <h2 class="text-center">Escolhe como queres jogar</h2>
        <div class="ornament gold" aria-hidden="true">◇</div>
        <fieldset class="player-selector">
            <legend>Jogadores</legend>
            <div class="player-options"><input class="btn-check" type="radio" name="players" id="players-1" value="1"
                                                   autocomplete="off" /><label class="btn player-button" for="players-1">1</label><input
                class="btn-check" type="radio" name="players" id="players-2" value="2" autocomplete="off" /><label
                class="btn player-button" for="players-2">2</label><input class="btn-check" type="radio"
                                                                          name="players" id="players-3" value="3" autocomplete="off" /><label class="btn player-button"
                                                                                    for="players-3">3</label><input class="btn-check" type="radio" name="players" id="players-4"
                                                value="4" autocomplete="off" checked /><label class="btn player-button"
                                                              for="players-4">4-8</label>
            </div>
            </fieldset>
            <p class="text-center muted mb-4">Game Masters não pagam nem entram nesta contagem.</p><noscript>
            <p class="text-center">Os preços apresentados são para 4 jogadores. Ativa JavaScript para selecionar outro
                número.</p>
            </noscript>
            <p id="pricing-announcement" class="visually-hidden" role="status" aria-live="polite" aria-atomic="true"></p>
            <div class="row g-3 g-xxl-4">
                <div class="col-sm-6 col-xl-3">
                    <article class="price-card h-100" data-price-model="Board games">
                        <div class="price-art price-art-board" role="img"
                             aria-label="Espaço reservado para ilustração: Jogos de tabuleiro"></div>
                        <h3>Jogos de tabuleiro</h3>
                        <div class="ornament" aria-hidden="true">◇</div>
                        <p>Entrada por pessoa</p>
                        <div class="price-line"><del data-original>5 €</del><strong data-entry>2,50 €</strong></div>
                        <p class="consumption" data-consumption>+ 7,50 € para consumos</p>
                        <div class="price-total"><span>Total por pessoa:</span><strong data-total>10 €</strong></div>
                    </article>
                </div>
                <div class="col-sm-6 col-xl-3">
                    <article class="price-card h-100" data-price-model="TTRPG own DM">
                        <div class="price-art price-art-party" role="img"
                             aria-label="Espaço reservado para ilustração: RPG com o teu DM"></div>
                        <h3>RPG com o teu DM</h3>
                        <div class="ornament" aria-hidden="true">◇</div>
                        <p>Entrada por pessoa</p>
                        <div class="price-line"><del data-original>10 €</del><strong data-entry>5 €</strong></div>
                        <p class="consumption" data-consumption>+ 5 € para consumos</p>
                        <div class="price-total"><span>Total por pessoa:</span><strong data-total>10 €</strong></div>
                    </article>
                </div>
                <div class="col-sm-6 col-xl-3">
                    <article class="price-card h-100" data-price-model="TTRPG paid DM">
                        <div class="price-art price-art-guided" role="img"
                             aria-label="Espaço reservado para ilustração: RPG com DM pago"></div>
                        <h3>RPG com DM pago</h3>
                        <div class="ornament" aria-hidden="true">◇</div>
                        <p>Entrada por pessoa</p>
                        <div class="price-line"><del data-original>20 €</del><strong data-entry>10 €</strong></div>
                        <p class="consumption" data-consumption>Sem consumo mínimo adicional</p>
                        <div class="price-total"><span>Total por pessoa:</span><strong data-total>10 €</strong></div>
                    </article>
                </div>
                <div class="col-sm-6 col-xl-3">
                    <article class="price-card h-100" data-price-model="Workshop">
                        <div class="price-art price-art-workshop" role="img"
                             aria-label="Espaço reservado para ilustração: Workshop"></div>
                        <h3>Workshop</h3>
                        <div class="ornament" aria-hidden="true">◇</div>
                        <p>Entrada por pessoa</p>
                        <div class="price-line"><del data-original>20 €</del><strong data-entry>15 €</strong></div>
                        <p class="consumption" data-consumption>Sem consumo mínimo adicional</p>
                        <div class="price-total"><span>Total por pessoa:</span><strong data-total>15 €</strong></div>
                    </article>
                </div>
            </div>
            <div class="ornament gold mt-4" aria-hidden="true">◇</div>
            <p class="eyebrow text-center muted mb-0">BOAS HISTÓRIAS ENCONTRAM SEMPRE MESA</p>
        </div>
    </section>