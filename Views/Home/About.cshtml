@{
    Layout = "_Layout"; ViewData["Title"] = "Sobre";
}

<section id="projeto" class="council-section parchment">
    <div class="container-xxl">
        <div class="row align-items-center g-5">
            <div class="col-lg-5">
                <h2>Projeto</h2>
                <p class="lead">A nossa mesa também é tua.</p>
                <p>The Council nasceu de um grupo de amigos e da vontade de ir mais longe nos jogos de mesa. Criamos
                    cenários à mão, exploramos novas mecânicas e damos vida a mundos. Agora, abrimos a nossa mesa para
                    partilhar essa paixão contigo.</p>
                    <p>Acreditamos nos jogos como uma forma de nos conhecermos, criar ligações e encontrar o nosso lugar.
                    </p><span class="council-rule"></span>
                    <p class="eyebrow">MAIS DO QUE JOGOS.<br />UM PASSO DE CADA VEZ.</p>
                </div>
                <div class="col-lg-7">
                    <div class="art-placeholder art-project" role="img"
                         aria-label="Espaço reservado para fotografia do projeto"></div>
                </div>
            </div>
        </div>
    </section>
    <section id="game-masters" class="council-section parchment">
        <div class="container-xxl">
            <h2>Game Masters</h2>
            <p class="lead mb-5">Diferentes estilos. A mesma paixão por jogar.</p>
            <article class="gm-row row g-4 align-items-center">
                <div class="col-12 col-md-6">
                    <h3>António dos Santos</h3>
                    <p class="mb-0">O primeiro anfitrião do Conselho.
                        Desde o primeiro jogo acreditou no poder dos jogos de mesa.
                        Entre jogos de campanha e cenários feitos à mão, adora dar vida a mundos negros,
                        onde as escolhas que os jogadores fazem, continuam as suas histórias.
                    </p>
                </div>
                <div class="col-md-6">
                    <div class="campaign-placeholder" role="img" aria-label="Espaço reservado para logótipo da campanha">
                        <span>
                            <img class="brand-logo" src="@Url.Content("~/images/brand-logos/Dark-sun-logo.png")" alt=""
                                 aria-hidden="true" />
                        </span>
                        <span>
                            <img class="brand-logo" src="@Url.Content("~/images/brand-logos/Game-of-Thrones-logo.png")"
                                 alt="" aria-hidden="true" />
                        </span>
                        <span>
                            <img class="brand-logo" src="@Url.Content("~/images/brand-logos/Harry-Potter-logo.png")" alt=""
                                 aria-hidden="true" />
                        </span>
                        <span>
                            <img class="brand-logo" src="@Url.Content("~/images/brand-logos/Logo-Ravenloft.png")" alt=""
                                 aria-hidden="true" />
                        </span>
                        <span>
                            <img class="brand-logo"
                                 src="@Url.Content("~/images/brand-logos/The-Lord-of-the-Rings-logo.png")" alt=""
                                 aria-hidden="true" />
                        </span>
                        <span>
                            <img class="brand-logo" src="@Url.Content("~/images/brand-logos/Logo-Forgotten-Realms.png")"
                                 alt="" aria-hidden="true" />
                        </span>
                        <span>
                            <img class="brand-logo" src="@Url.Content("~/images/brand-logos/world-of-warcraft-Logo.png")"
                                 alt="" aria-hidden="true" />
                        </span>
                    </div>
                </div>
            </article>
            <article class="gm-row row g-4 align-items-center">
                <div class="col-12 col-md-6">
                    <h3>Eduardo Dantas</h3>
                    <p class="mb-0">A narrativa dá o rumo às suas mesas. Prepara cada sessão com método e atenção ao
                        detalhe, conjugando a imersão na história com o prazer de a viver em conjunto.
                    </p>
                </div>
                <div class="col-md-6">
                    <div class="campaign-placeholder" role="img" aria-label="Espaço reservado para logótipo da campanha">
                        <span>
                            <img class="brand-logo" src="@Url.Content("~/images/brand-logos/Logo-Ravenloft.png")" alt=""
                                 aria-hidden="true" />
                        </span>
                        <span>
                            <img class="brand-logo"
                                 src="@Url.Content("~/images/brand-logos/The-Lord-of-the-Rings-logo.png")" alt=""
                                 aria-hidden="true" />
                        </span>
                        <span>
                            <img class="brand-logo" src="@Url.Content("~/images/brand-logos/Logo-Forgotten-Realms.png")"
                                 alt="" aria-hidden="true" />
                        </span>
                        <span>
                            <img class="brand-logo" src="@Url.Content("~/images/brand-logos/Skyrim-logo.png")" alt=""
                                 aria-hidden="true" />
                        </span>
                    </span>
                    <span>
                        <img class="brand-logo" src="@Url.Content("~/images/brand-logos/The-Witcher-logo.png")" alt=""
                             aria-hidden="true" />
                    </span>
                </div>
            </div>
        </article>
        <article class="gm-row row g-4 align-items-center">
            <div class="col-12 col-md-6">
                <h3>Augusto Ferreira</h3>
                <p class="mb-0">Companheiro de mesa desde o início, traz entusiasmo e criatividade a qualquer jogo. Nas
                    suas aventuras, a ação ganha ritmo de cinema e há sempre espaço para uma ideia inesperada.
                </p>
            </div>
            <div class="col-md-6">
                <div class="campaign-placeholder" role="img" aria-label="Espaço reservado para logótipo da campanha">
                    <span>
                        <img class="brand-logo" src="@Url.Content("~/images/brand-logos/Logo-Forgotten-Realms.png")"
                             alt="" aria-hidden="true" />
                    </div>
                </div>
            </article>
        </article>
        <article class="gm-row row g-4 align-items-center">
            <div class="col-12 col-md-6">
                <h3>Miguel Pacheco</h3>
                <p class="mb-0">Entrega-se a cada aventura com humor e dedicação, dentro e fora do jogo. Gosta de um bom
                    combate e de dar umas gargalhadas, sempre com o cuidado de tornar a experiência melhor para quem
                    está à mesa.
                </p>
            </div>
            <div class="col-md-6">
                <div class="campaign-placeholder" role="img" aria-label="Espaço reservado para logótipo da campanha">
                    <span>
                        <img class="brand-logo" src="@Url.Content("~/images/brand-logos/Logo-Ravenloft.png")" alt=""
                             aria-hidden="true" />
                    </span>
                    <span>
                        <img class="brand-logo" src="@Url.Content("~/images/brand-logos/Logo-Forgotten-Realms.png")"
                             alt="" aria-hidden="true" />
                    </span>
                    <span>
                        <img class="brand-logo" src="@Url.Content("~/images/brand-logos/Skyrim-logo.png")" alt=""
                             aria-hidden="true" />
                    </span>
                </span>
                <span>
                    <img class="brand-logo" src="@Url.Content("~/images/brand-logos/The-Witcher-logo.png")" alt=""
                         aria-hidden="true" />
                </span>
                <span>
                    <img class="brand-logo" src="@Url.Content("~/images/brand-logos/Game-of-Thrones-logo.png")" alt=""
                         aria-hidden="true" />
                </span>
            </div>
        </div>
    </article>
        <article class="gm-row row g-4 align-items-center">
            <div class="col-12 col-md-6">
                <h3>Pedro Fernandes</h3>
                <p class="mb-0">Gosta de um bom desafio e de o partilhar entre amigos. Dos jogos de estratégia às campanhas cooperativas, prefere seguir o flow, e depois descobrindo os pormenores à medida que fazem falta.
                </p>
            </div>
            <div class="col-md-6">
                <div class="campaign-placeholder" role="img" aria-label="Espaço reservado para logótipo da campanha">
                    <span>
                        <img class="brand-logo" src="@Url.Content("~/images/covers/ark-nova.webp")" alt=""
                             aria-hidden="true" />
                    </span>
                    <span>
                        <img class="brand-logo" src="@Url.Content("~/images/covers/frosthaven.webp")"
                             alt="" aria-hidden="true" />
                    </span>
                    <span>
                        <img class="brand-logo" src="@Url.Content("~/images/covers/ghost-stories.webp")" alt=""
                             aria-hidden="true" />
                    </span>
                </span>
            </div>
        </div>
    </article>

    <p class="eyebrow mt-5">DIFERENTES HISTÓRIAS.<br />A MESMA PAIXÃO.</p>
</div>
</section>
<div class="art-landscape" role="img" aria-label="Espaço reservado para paisagem de fantasia"></div>
